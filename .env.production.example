# ============================================================
# RentHub Backend - Production Environment Template
# Copy to your hosting provider (Render/Railway/Docker).
# All SENTRY_* / *_SECRET keys are placeholders — fill real values.
# Generate secrets with: openssl rand -hex 32
# ============================================================

# --- Core ---
NODE_ENV=production
PORT=5000
API_VERSION=v1

# Comma-separated allowed origins (CORS). Add ALL production domains.
CLIENT_URL=https://yourdomain.com,https://www.yourdomain.com

# Set to true when behind a reverse proxy / load balancer (Render/Railway/Nginx)
TRUST_PROXY=true

# Log level (info | debug | warn | error)
LOG_LEVEL=info

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/renthub?retryWrites=true&w=majority

# --- JWT ---
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudinary (image/file storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (payments) ---
# Use TEST keys for sandbox, LIVE keys for production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- SMTP (transactional email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=RentHub <no-reply@yourdomain.com>

# --- SMS (Msg91 / Twilio) ---
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RENTHB
MSG91_TEMPLATE_ID=
# Twilio (if using Twilio instead)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@yourdomain.com

# --- Invoice ---
INVOICE_COMPANY_NAME=RentHub
INVOICE_COMPANY_ADDRESS=
INVOICE_COMPANY_GST=

# --- Monitoring (Sentry) ---
SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_TRACES_SAMPLE_RATE=0.1

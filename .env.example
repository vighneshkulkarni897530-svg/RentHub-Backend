# ============================================================
# RentHub Backend - Environment Variables (copy to .env)
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_VERSION=v1

# --- MongoDB Atlas ---
# Replace with your real Atlas URI, e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/renthub?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/renthub

# --- JWT ---
JWT_ACCESS_SECRET=change_me_to_a_long_random_access_secret
JWT_REFRESH_SECRET=change_me_to_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Email / SMTP (Nodemailer) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=RentHub <no-reply@renthub.com>

# --- Logging ---
LOG_LEVEL=info


# ============================================================
# RentHub Backend - Environment Variables
# Copy this file to `.env` and fill in real values.
# ============================================================

# ---------- Server ----------
# Node environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=5000

# Comma-separated list of allowed CORS origins (frontend URLs)
CLIENT_URL=http://localhost:3000

# API version prefix (used in routes: /api/v1)
API_VERSION=v1

# ---------- Database (MongoDB Atlas / local) ----------
# Full MongoDB connection string.
# Local:  mongodb://localhost:27017/renthub
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/renthub
MONGODB_URI=mongodb://localhost:27017/renthub

# ---------- JWT Authentication ----------
# Secret used to sign access tokens (use a long random string in prod)
JWT_ACCESS_SECRET=change_me_access_secret

# Secret used to sign refresh tokens (use a different random string in prod)
JWT_REFRESH_SECRET=change_me_refresh_secret

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Cloudinary (image uploads) ----------
# Cloudinary cloud name
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key
CLOUDINARY_API_KEY=

# Cloudinary API secret
CLOUDINARY_API_SECRET=

# ---------- Razorpay (payments) ----------
# Razorpay key ID
RAZORPAY_KEY_ID=

# Razorpay key secret
RAZORPAY_KEY_SECRET=

# ---------- SMTP (email notifications) ----------
# SMTP host (e.g. smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP username
SMTP_USER=

# SMTP password / app password
SMTP_PASS=

# From address for outgoing emails
EMAIL_FROM=RentHub <no-reply@renthub.com>

# ---------- Logging ----------
# Log level: error | warn | info | http | debug
LOG_LEVEL=info

# ---------- Trusted Proxy ----------
# Set to the number of reverse proxies in front (e.g. 1 for nginx)
# Controls req.ip/rate-limit trust for X-Forwarded-For
TRUST_PROXY=1

# ---------- Ollama (local AI voice assistant) ----------
# Ollama must be installed and running locally.
# See docs/AI_VOICE_ASSISTANT.md for setup instructions.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=30000
</content>
